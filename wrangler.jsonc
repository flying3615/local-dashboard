{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "paraparaumu-dashboard",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-21",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "paraparaumu-dashboard",
      "database_id": "e67c12fa-0a37-47f4-bee3-414a20a6e3e6"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "REFRESH_QUEUE",
        "queue": "paraparaumu-refresh"
      }
    ],
    "consumers": [
      {
        "queue": "paraparaumu-refresh",
        "max_batch_size": 1,
        "max_batch_timeout": 5
      }
    ]
  },
  "triggers": {
    "crons": ["0 1 * * *"]
  }
}
